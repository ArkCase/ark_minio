#!/bin/bash
#
# Raise the dependencies of the Go module in the current directory to the
# minimum versions ("floors") listed in patches.yaml (next to this script).
#
# usage: apply-patches fix-set-1 [ fix-set-2 ... fix-set-N ]
#
# For every module in the requested fix sets (the highest floor wins when a
# module appears more than once):
#
#   - if the version Go currently selects already meets the floor, it is left
#     alone, so nothing is ever downgraded;
#   - otherwise "go get module@floor" raises it. Modules are raised one at a
#     time and the current version is re-read before each one, so every
#     "go get" is an upgrade.
#
# Then "go mod tidy" runs. Tidy drops the requirement on any module that no
# compiled package imports, which can leave that module below its floor
# again, so the floors are re-applied afterwards. Finally every floor is
# checked again: the script exits 0 only if every module is present and at
# or above its floor.
#

set -euo pipefail

CALLED="${BASH_ARGV0:-${BASH_SOURCE:-${0}}}"
SCRIPT="$(readlink -f "${CALLED}")"
BASEDIR="$(dirname "${SCRIPT}")"
SCRIPT="$(basename "${SCRIPT}")"

timestamp()
{
	date -Ins -u
}

say()
{
	local SUFFIX=""
	[ -v PARALLEL_ID ] && SUFFIX="|${!PARALLEL_ID}"
	echo -e "$(timestamp) [${$}${SUFFIX}]: ${@}"
}

ok()
{
	say "✅ ${@}"
}

err()
{
	say "❌ ${@}" 1>&2
}

fail()
{
	err "${@}"
	exit ${EXIT_CODE:-1}
}

yaml2json()
{
	command python3 <(cat <<-EOF
	import yaml
	import json
	import sys
	# Must use spaces to indent within the script
	try:
	    yaml_object = yaml.safe_load(sys.stdin)
	    json.dump(yaml_object, sys.stdout)
	except KeyboardInterrupt:
	    sys.exit(1)
	EOF
	)
}

if [ ${#} -lt 1 ] ; then
	echo "usage: ${CALLED} fix-1 [ fix-2 fix-3 ... fix-N ]"
	exit 1
fi

for TOOL in go jq python3 ; do
	command -v "${TOOL}" &>/dev/null || fail "The required tool [${TOOL}] was not found in the PATH"
done

# Semver precedence as Go applies it: prereleases (including pseudo-versions)
# sort below their release, and build metadata ("+incompatible") is ignored
JQ_SEMVER='
def semver_key:
	(split("+")[0] | ltrimstr("v")) as $s
	| ($s | index("-")) as $i
	| (if $i == null then [$s, null] else [$s[:$i], $s[($i + 1):]] end) as [$core, $pre]
	| ($core | split(".") | map(tonumber))
	  + [ (if $pre == null then 1 else 0 end),
	      (if $pre == null then [] else ($pre | split(".") | map(if test("^[0-9]+$") then [0, tonumber] else [1, .] end)) end) ];
'

# version_ok HAVE WANT: succeeds if HAVE >= WANT
version_ok()
{
	jq -en --arg have "${1}" --arg want "${2}" "${JQ_SEMVER} (\$have | semver_key) >= (\$want | semver_key)" &>/dev/null
}

# current_version MODULE: the version of MODULE that Go selects (the
# replacement's version if a replace directive applies). Fails the script if
# the module is not in the module graph or is replaced by a local directory.
current_version()
{
	local VERSION
	VERSION="$(go list -m -f '{{with .Replace}}{{.Version}}{{else}}{{.Version}}{{end}}' "${1}" 2>/dev/null)" \
		|| fail "Cannot read the version of [${1}] (not in the module graph?):\n$(go list -m "${1}" 2>&1)"
	[ -n "${VERSION}" ] || fail "[${1}] is replaced by a local directory, so it can't be patched or checked"
	echo "${VERSION}"
}

# raise_all: raise every module that is below its floor, one "go get" at a
# time, re-reading the current version first so every "go get" is an upgrade
raise_all()
{
	local MOD WANT HAVE OUT
	while read -r MOD WANT ; do
		[ -n "${MOD}" ] || continue
		HAVE="$(current_version "${MOD}")"
		if version_ok "${HAVE}" "${WANT}" ; then
			say "${MOD}: ${HAVE} already meets >= ${WANT}"
			continue
		fi
		say "${MOD}: raising ${HAVE} -> ${WANT} ..."
		OUT="$(go get "${MOD}@${WANT}" 2>&1 < /dev/null)" || fail "Failed to raise [${MOD}] to ${WANT} (rc=${?}):\n${OUT}"
	done <<< "${FLOORS}"
}

PATCHES_FILE="${BASEDIR}/patches.yaml"
if [ -f "${PATCHES_FILE}" ] && [ -r "${PATCHES_FILE}" ] ; then
	PATCHES_JSON="$(yaml2json < "${PATCHES_FILE}" 2>&1)" || fail "Failed to convert the fix file [${PATCHES_FILE}] to JSON (rc=${?}): ${PATCHES_JSON}"
else
	PATCHES_JSON="{}"
fi

# One "module floor" line per module, highest floor across the requested sets
FLOORS="$(jq -r "${JQ_SEMVER}"'
	. as $cfg
	| [ $ARGS.positional[] as $set
		| if (($cfg | type) != "object") or ($cfg | has($set) | not) then error("no fix set named [\($set)] in the patches file") else ($cfg[$set] // {}) end
		| to_entries[]
		| if ((.value | type) == "string") and (.value | test("^v[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.+-]+)?$")) then . else error("fix set [\($set)]: invalid version [\(.value)] for [\(.key)]") end ]
	| group_by(.key)[]
	| "\(.[0].key) \(map(.value) | max_by(semver_key))"
' --args "${@}" <<< "${PATCHES_JSON}" 2>&1)" || fail "Failed to read the fix set(s) [${*}] (rc=${?}): ${FLOORS}"

say "Applying fix set(s) [${*}] to the Go module at [${PWD}]"

raise_all

say "Go Tidy"
OUT="$(go mod tidy 2>&1 < /dev/null)" || fail "go mod tidy failed (rc=${?}):\n${OUT}"

# go mod tidy drops the requirement on any module that no compiled package
# imports, which can leave that module below its floor again: raise it back
say "Re-applying floors dropped by go mod tidy"
raise_all

FAILED=0
while read -r MOD WANT ; do
	[ -n "${MOD}" ] || continue
	HAVE="$(current_version "${MOD}")"
	if version_ok "${HAVE}" "${WANT}" ; then
		ok "${MOD}: ${HAVE} (>= ${WANT})"
	else
		err "${MOD}: ${HAVE} is below the required ${WANT}"
		FAILED=1
	fi
done <<< "${FLOORS}"

[ ${FAILED} -eq 0 ] || fail "Some patches were not applied (see above)"
ok "All patches applied"
